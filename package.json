    "@tanstack/react-table": "^8.21.3",
    "decimal.js": "^10.6.0",
    "dexie": "^4.4.4",
    "dexie-export-import": "^4.4.0",
    "lucide-react": "^1.25.0",
    "next": "16.2.11",
    "papaparse": "^5.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
